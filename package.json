{
  "name": "@frontend-page-builder-template/source",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Next.js + Nx frontend monorepo template: a public web app and an admin app sharing typed libraries, with a backend-agnostic services layer.",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.includes('npm')) { console.error('Use npm. Yarn and pnpm are not supported in this workspace.'); process.exit(1); }\"",
    "web": "nx run web:dev",
    "admin": "nx run admin:dev",
    "mock-api": "node tools/mock-api/server.mjs",
    "dev": "nx run-many -t dev -p web,admin,mock-api",
    "build": "nx run-many -t build -p web,admin --configuration=production",
    "lint": "nx run-many -t lint",
    "typecheck": "npm run typecheck:libs && npm run typecheck:apps",
    "typecheck:libs": "tsc -b libs/enums/tsconfig.lib.json libs/models/tsconfig.lib.json libs/dtos/tsconfig.lib.json libs/utils/tsconfig.lib.json libs/services/tsconfig.lib.json libs/components/tsconfig.lib.json libs/assets/tsconfig.lib.json",
    "typecheck:apps": "tsc -b apps/web/tsconfig.json && tsc -b apps/admin/tsconfig.json",
    "test": "nx run-many -t test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check:words": "node tools/scripts/check-words.mjs",
    "check": "npm run lint && npm run lint:tools && npm run typecheck && npm run test && npm run check:words && npm run format:check",
    "example:remove": "node tools/scripts/remove-example.mjs",
    "generate:domain": "nx g ./tools/generators:domain",
    "lint:tools": "eslint tools e2e --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@grapesjs/studio-sdk": "^1.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "grapesjs": "^0.22.16",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next": "^16.4.6",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^3.0.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@next/eslint-plugin-next": "^16.4.6",
    "@nx/devkit": "^22.7.6",
    "@nx/eslint": "^22.7.6",
    "@nx/jest": "^22.7.6",
    "@nx/js": "^22.7.6",
    "@nx/next": "^22.7.6",
    "@nx/react": "^22.7.6",
    "@playwright/test": "^1.61.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.3",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "nx": "^22.7.6",
    "postcss": "^8.5.16",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
    "typescript": "~5.9.2"
  }
}
