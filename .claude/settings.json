{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm test*)",
      "Bash(npm run format:check*)",
      "Bash(npm run check:words*)",
      "Bash(npm run e2e*)",
      "Bash(npm run build*)",
      "Bash(npx nx sync:check*)",
      "Bash(npx nx show *)",
      "Bash(npx nx graph *)",
      "Bash(npx nx run-many -t lint*)",
      "Bash(npx nx run-many -t test*)",
      "Bash(npx nx run-many -t build*)",
      "Bash(npx nx affected -t lint*)",
      "Bash(npx nx affected -t test*)",
      "Bash(npx nx affected -t build*)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier --check *)",
      "Bash(npx playwright test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git merge-base*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh repo create*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(npm publish*)",
      "Bash(npx shadcn*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.test.local)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.local)",
      "Read(./.check-words.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-sensitive-files.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
