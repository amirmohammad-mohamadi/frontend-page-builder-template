"use client";

import { useQueryClient } from "@tanstack/react-query";
import type { Create<%= className %>Dto, <%= className %>Dto, List<%= pluralClassName %>QueryDto, Update<%= className %>Dto } from "@dtos";
import { <%= className %>Model, PaginatedResponseModel } from "@models";
import type { ApiClientError } from "../shared/api-errors";
import { useMutation } from "../shared/hooks/use-mutation";
import { useQuery } from "../shared/hooks/use-query";
import type { NormalizedList } from "../shared/types";
import { <%= propertyName %>Api } from "./<%= fileName %>.api";
import { <%= propertyName %>QueryKeys } from "./<%= fileName %>.query-keys";

/** A page of <%= pluralFileName %> as a `PaginatedResponseModel`, so the UI reads `getItems()` and `getPaginate()`. */
export function use<%= pluralClassName %>(query: Partial<List<%= pluralClassName %>QueryDto> = {}, options: { enabled?: boolean } = {}) {
  return useQuery<NormalizedList<<%= className %>Dto>, ApiClientError, PaginatedResponseModel<<%= className %>Dto, <%= className %>Model>>({
    queryKey: <%= propertyName %>QueryKeys.list(query),
    queryFn: () => <%= propertyName %>Api.list(query),
    select: (list) => new PaginatedResponseModel(<%= className %>Model, list),
    enabled: options.enabled,
  });
}

/** One <%= fileName %> by id; disabled until an id is known. */
export function use<%= className %>(id: number | string | undefined) {
  return useQuery<<%= className %>Dto, ApiClientError, <%= className %>Model>({
    queryKey: <%= propertyName %>QueryKeys.detail(id ?? ""),
    queryFn: () => <%= propertyName %>Api.get(id as number | string),
    select: (dto) => new <%= className %>Model(dto),
    enabled: id !== undefined && id !== "",
  });
}

/** Creates a <%= fileName %> and refreshes every list. */
export function useCreate<%= className %>(options: { onSuccess?: (created: <%= className %>Model) => void } = {}) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (data: Create<%= className %>Dto) => <%= propertyName %>Api.create(data),
    onSuccess: (dto) => {
      void queryClient.invalidateQueries({ queryKey: <%= propertyName %>QueryKeys.lists() });
      options.onSuccess?.(new <%= className %>Model(dto));
    },
  });
}

/** Updates a <%= fileName %>, writes the answer into its detail query and refreshes every list. */
export function useUpdate<%= className %>(options: { onSuccess?: (updated: <%= className %>Model) => void } = {}) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: ({ id, data }: { id: number | string; data: Update<%= className %>Dto }) => <%= propertyName %>Api.update(id, data),
    onSuccess: (dto) => {
      queryClient.setQueryData(<%= propertyName %>QueryKeys.detail(dto.id), dto);
      void queryClient.invalidateQueries({ queryKey: <%= propertyName %>QueryKeys.lists() });
      options.onSuccess?.(new <%= className %>Model(dto));
    },
  });
}

/** Deletes a <%= fileName %>, drops its detail query and refreshes every list. */
export function useDelete<%= className %>(options: { onSuccess?: () => void } = {}) {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (id: number | string) => <%= propertyName %>Api.remove(id),
    onSuccess: (_void, id) => {
      queryClient.removeQueries({ queryKey: <%= propertyName %>QueryKeys.detail(id) });
      void queryClient.invalidateQueries({ queryKey: <%= propertyName %>QueryKeys.lists() });
      options.onSuccess?.();
    },
  });
}
