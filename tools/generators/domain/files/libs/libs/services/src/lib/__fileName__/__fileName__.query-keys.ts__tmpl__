import type { List<%= pluralClassName %>QueryDto } from "@dtos";

/** Query keys of the <%= fileName %> domain; every list key starts with `lists()` so one invalidation refreshes them all. */
export const <%= propertyName %>QueryKeys = {
  all: ["<%= pluralFileName %>"] as const,
  lists: () => [...<%= propertyName %>QueryKeys.all, "list"] as const,
  list: (query: Partial<List<%= pluralClassName %>QueryDto>) => [...<%= propertyName %>QueryKeys.lists(), query] as const,
  details: () => [...<%= propertyName %>QueryKeys.all, "detail"] as const,
  detail: (id: number | string) => [...<%= propertyName %>QueryKeys.details(), String(id)] as const,
};
