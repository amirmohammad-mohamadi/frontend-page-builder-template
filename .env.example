# Copy to `.env` at the workspace root. Every value has a working default for
# local development against the bundled mock API (`npm run mock-api`), so a
# fresh clone runs with this file copied as it is.

# ── Backend ──────────────────────────────────────────────────────────────────
# Base URL the browser uses for PUBLIC endpoints (no auth). Inlined at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Base URL the Next.js server uses to reach the backend (BFF routes, SSR).
# Often an internal hostname in production; the same as above locally.
INTERNAL_API_BASE_URL=http://localhost:4000
# Path prefixes the BFF proxy forwards with the session token, comma-separated.
# Everything else is refused by the proxy. Defaults shown. `/api/v1/pages` is
# there for the signed-in draft preview (`/api/v1/pages/<slug>/preview`); the
# admin prefix already covers `/api/v1/admin/pages` and `/api/v1/admin/media`.
WEB_PROXY_PREFIXES=/api/v1/me,/api/v1/examples,/api/v1/pages
ADMIN_PROXY_PREFIXES=/api/v1/admin,/api/v1/examples,/api/v1/pages

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session cookies carry the Secure flag in every production build. Set this to
# "false" only for a staging host served over plain http; leave it empty otherwise.
AUTH_COOKIE_SECURE=

# ── Localisation (web app) ───────────────────────────────────────────────────
# Must be one of the locales in apps/web/src/i18n/locales.ts.
NEXT_PUBLIC_DEFAULT_LOCALE=en
# The web app's public origin, for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Page builder (admin app) ─────────────────────────────────────────────────
# Which editor the admin app mounts: "core" (bundled GrapesJS shell, no key
# needed, the default) or "studio" (the GrapesJS Studio SDK host).
NEXT_PUBLIC_BUILDER_EDITOR=core
# Your own GrapesJS Studio licence key from https://app.grapesjs.com, used only
# when the editor is "studio". Core needs no key. Never commit a real key: keep
# it in your local .env (or the deployment's secrets), not in this file.
NEXT_PUBLIC_GRAPESJS_LICENSE_KEY=

# ── Observability (optional) ─────────────────────────────────────────────────
# The template ships no error-tracking vendor. Wire one in
# apps/*/src/lib/observability.ts and read its DSN or key here.
# ERROR_TRACKING_DSN=
